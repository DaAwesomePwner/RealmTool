{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealmTool",
  "version": "0.1.0",
  "identifier": "net.realmtool.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [{ "title": "RealmTool", "width": 1100, "height": 760, "minWidth": 820, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; connect-src http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data:; style-src 'self'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
